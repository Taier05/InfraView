# 仅作为模板。正式部署前必须复制为 .env、更换示例密码并限制文件权限；
# 禁止直接使用此示例凭据运行正式环境。
INFRAVIEW_USERNAME=admin
INFRAVIEW_PASSWORD=change-me-please

# 直接访问使用 8080（监听全部宿主接口）；仅供本机反向代理时改为 127.0.0.1:8080。
# 使用 HTTPS 反向代理时还必须把 INFRAVIEW_COOKIE_SECURE 改为 true。
INFRAVIEW_PORT=8080
INFRAVIEW_LISTEN_ADDR=:8080
INFRAVIEW_COOKIE_SECURE=false
INFRAVIEW_SESSION_TTL=12h

# 默认不信任任何代理转发头。仅在反向代理部署时填写直接连接 InfraView 的代理 CIDR；
# 多个 CIDR 用英文逗号分隔。可信代理必须覆盖并传入单值 X-Real-IP。
# 示例：INFRAVIEW_TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.18.0.5/32
INFRAVIEW_TRUSTED_PROXY_CIDRS=

# Mock MVP 仅支持 mock，真实 Nightingale 适配器待测试环境就绪后实现。
INFRAVIEW_DATA_SOURCE=mock
INFRAVIEW_MOCK_HOST_COUNT=32

# 刷新、缓存、降级与阈值设置。
INFRAVIEW_REFRESH_INTERVAL=30s
INFRAVIEW_INVENTORY_TTL=60s
INFRAVIEW_CURRENT_METRICS_TTL=20s
INFRAVIEW_RANGE_TTL=60s
INFRAVIEW_HEALTH_TTL=15s
INFRAVIEW_MAX_STALE=5m
INFRAVIEW_UPSTREAM_TIMEOUT=10s
INFRAVIEW_WARNING_PERCENT=80
INFRAVIEW_CRITICAL_PERCENT=90
INFRAVIEW_NETWORK_WARNING_BPS=83886080
INFRAVIEW_NETWORK_CRITICAL_BPS=104857600

TZ=Asia/Hong_Kong
